{
  "name": "mvpack-remotion",
  "version": "2.1.0",
  "private": true,
  "description": "MV skill pack - Remotion lyric motion system (32 styles)",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/doctor.ts",
    "start": "tsx scripts/wizard.ts",
    "mv": "tsx scripts/mv.ts",
    "preview": "tsx scripts/mv.ts --stills-only",
    "stills": "tsx scripts/mv.ts --stills-only",
    "overlay": "tsx scripts/mv.ts --overlay-only",
    "showcase": "tsx scripts/showcase.ts",
    "presets-demo": "tsx scripts/presets_demo.ts",
    "fonts": "tsx scripts/fonts.ts list",
    "fonts:add": "tsx scripts/fonts.ts add",
    "fonts:fetch": "tsx scripts/fonts.ts fetch",
    "fonts:sync": "tsx scripts/fonts.ts sync",
    "fonts:sheet": "tsx scripts/fonts.ts sheet",
    "style:new": "tsx scripts/style_new.ts",
    "genre-demo": "tsx scripts/genre_demo.ts",
    "style:check": "tsx scripts/style_new.ts check",
    "styles": "tsx scripts/styles.ts",
    "scenes": "tsx scripts/scenes.ts",
    "studio": "remotion studio",
    "test": "vitest run",
    "qc:black": "tsx scripts/qc_black.ts",
    "typecheck": "tsc --noEmit",
    "edit": "tsx scripts/edit.ts",
    "approve": "tsx scripts/approve.ts",
    "timing": "tsx scripts/timing.ts",
    "timeline": "tsx scripts/timing.ts --png",
    "gen": "tsx scripts/gen.ts",
    "made": "tsx scripts/made.ts",
    "models": "tsx scripts/gen.ts models",
    "gallery": "tsx scripts/gen.ts gallery",
    "sample": "tsx scripts/mv.ts --sample",
    "faces": "tsx scripts/faces.ts",
    "postinstall": "tsx scripts/fonts.ts sync && tsx scripts/plans_sync.ts && tsx scripts/editor_fonts.ts",
    "doctor": "tsx scripts/doctor.ts",
    "estimate": "tsx scripts/gen.ts estimate",
    "parts": "tsx scripts/parts.ts",
    "pro-demo": "tsx scripts/pro_demo.ts",
    "editor": "tsx scripts/editor.ts",
    "editor:demo": "tsx scripts/editor.ts --demo --project editor-demo",
    "fonts:editor": "tsx scripts/editor_fonts.ts",
    "editor:update": "tsx scripts/editor_update.ts",
    "recipe:battle": "tsx scripts/recipe_battle.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/media-utils": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538",
    "yaml": "^2.9.1",
    "@remotion/bundler": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
